# Twitch Developer Console app credentials. The callback must exactly match the
# registered OAuth Redirect URL. If your console requires HTTPS, use an HTTPS
# tunnel to localhost:8787 and put that exact https://.../auth/callback URL below.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback
LOREKEEPER_DASHBOARD_URL=http://localhost:8787

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the resulting key private; it encrypts the saved Twitch refresh/access tokens.
TOKEN_ENCRYPTION_KEY=

# Optional local LM Studio story writer. Keep provider=none for deterministic templates.
LOREKEEPER_LLM_PROVIDER=none
LOREKEEPER_LLM_BASE_URL=http://host.docker.internal:1234/v1
# Leave blank to auto-select the model currently loaded in LM Studio.
LOREKEEPER_LLM_MODEL=
LOREKEEPER_LLM_TIMEOUT_SECONDS=8
# Real semantic hunts: set lm_studio and the exact loaded model ID.
# Judge rehearsal without a model: set demo_lexicon (limited, curated vocabulary).
# feature_hash is only for offline lore indexing and cannot score a signal hunt.
# Default for a runnable no-model rehearsal. Switch to lm_studio for real open-vocabulary semantics.
EMBEDDING_PROVIDER=demo_lexicon
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=8
# Extra comma-separated chat words to reject before they appear on the overlay.
LOREKEEPER_GUESS_BLOCKLIST=
GRAFANA_USER=admin
GRAFANA_PASSWORD=lorekeeper-demo
PG_PASSWORD=lorekeeper-local
LOREKEEPER_RAW_RETENTION_DAYS=7
# This iteration is a science-community story game; no dashboard selector needed.
LOREKEEPER_EXPERIENCE=science
# Seconds that live chat can vote in a community chapter (15-180).
LOREKEEPER_CHAPTER_VOTE_SECONDS=45
# Seconds for a live semantic signal hunt (45-180).
LOREKEEPER_SIGNAL_SECONDS=90

# Local server options
LOREKEEPER_HOST=127.0.0.1
PORT=8787
# LOREKEEPER_DB=./data/lorekeeper.db
