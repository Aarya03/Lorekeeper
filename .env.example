# Twitch Developer Console app credentials. Add http://localhost:8787/auth/callback
# as the app's OAuth Redirect URL. The app must be configured as a confidential client.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the resulting key private; it encrypts the saved Twitch refresh/access tokens.
TOKEN_ENCRYPTION_KEY=

# Optional OpenAI phrasing for eligible live reactions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GRAFANA_PASSWORD=lorekeeper-demo
PG_PASSWORD=lorekeeper-local
LOREKEEPER_RAW_RETENTION_DAYS=7

# Local server options
LOREKEEPER_HOST=127.0.0.1
PORT=8787
# LOREKEEPER_DB=./data/lorekeeper.db
